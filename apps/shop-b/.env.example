# ── Local dev ────────────────────────────────────────────────────────────────
# Copy to .env and fill in values. Never commit .env.

# Slug of this store as registered in the DAM (e.g. "oakhaus")
NUXT_PUBLIC_STORE_SLUG=my-store-slug

# DAM backend base URL
NUXT_PUBLIC_DAM_BASE_URL=https://localhost:8443

# Copy dev TLS certs from the DAM project:
#   cp /path/to/dam/tls/development.crt  ../../tls/development.crt
#   cp /path/to/dam/tls/development.key  ../../tls/development.key
#   cp /path/to/dam/tls/development_ca.crt ../../tls/development_ca.crt

# ── Vercel dashboard (set per-project, do not put here) ───────────────────────
# NUXT_PUBLIC_STORE_SLUG    → slug for this seller's store in the DAM
# NUXT_PUBLIC_DAM_BASE_URL  → production DAM URL (e.g. https://api.yourdomain.com)
